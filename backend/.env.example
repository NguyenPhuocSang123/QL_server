PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ql_server
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d

# Tùy chọn: Chatbot AI (Google Gemini) - https://aistudio.google.com/apikey
# Không có key vẫn chạy được (dùng trả lời theo từ khóa)
GEMINI_API_KEY=

# Cảm biến nhiệt độ/độ ẩm tự động (mô phỏng theo server online + điều hòa)
SENSOR_AUTO_UPDATE=true
SENSOR_INTERVAL_SECONDS=30
# Tùy chọn: key cho POST /api/rooms/:id/sensor-reading (cảm biến thật)
# SENSOR_API_KEY=
