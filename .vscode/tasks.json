{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install All",
      "type": "shell",
      "command": "npm run install:all",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build"
    },
    {
      "label": "Seed Database",
      "type": "shell",
      "command": "npm run seed",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build"
    },
    {
      "label": "Backend Dev",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Server running on port"
        }
      }
    },
    {
      "label": "Frontend Dev",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local:"
        }
      }
    },
    {
      "label": "Run Full Stack",
      "dependsOn": ["Backend Dev", "Frontend Dev"],
      "dependsOrder": "parallel",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ]
}
